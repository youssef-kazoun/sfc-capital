# Postgres connection string. Works with Neon, Supabase, Cloud SQL, or any
# standard Postgres provider. Must include sslmode=require for most managed
# providers (Neon includes it in the string it gives you).
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="https://your-app-url.example.com"

# Market data (leave empty to use the built-in MockProvider)
MARKET_DATA_API_KEY=
MARKET_DATA_API_URL=

# Payments (leave empty to use the built-in mock payment adapter)
PAYMENT_API_KEY=
PAYMENT_API_SECRET=

# CRM (leave empty to use the built-in mock CRM adapter)
CRM_API_URL=
CRM_API_KEY=

# Notifications
EMAIL_API_KEY=
WHATSAPP_API_KEY=
